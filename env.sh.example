#!/bin/bash
# Machine-specific environment variables for daily maintenance
# Copy this file to env.sh and fill in your values.
# env.sh is gitignored and will not be committed.

# Network interfaces
# Find yours with: ip link show
export MAIN_WIRED="enp0s25"
export MAIN_WIRELESS="wlan0"

# VPN DNS server address (checked during DNS leak detection)
export VPN_DNS="10.0.0.1"

# Main ZFS pool name
export ZFS_POOL="tank"

# Syncoid remote replication (leave empty to disable)
# Host should match an SSH config entry
export SYNCOID_REMOTE_HOST=""
export SYNCOID_REMOTE_POOL=""

# Space-delimited dataset paths relative to ZFS_POOL
# Each is prefixed with ${ZFS_POOL}/ to form full dataset paths
# Example: "user/src user/documents" becomes "tank/user/src tank/user/documents"
export SYNCOID_DATASETS=""

# Space-delimited backup config names (matching files in backup-configs/)
# Each name corresponds to a backup-configs/<name>.conf file
export ZFS_BACKUP_TARGETS=""

# Cloud sync targets (local_path:remote_name:)
# Remote name must include trailing colon (rclone format)
export CLOUD_SYNCS=""

# Root filesystem backup pool and dataset (leave empty to skip)
# ROOT_BACKUP_POOL: the pool to import for root backup
# ROOT_BACKUP_CONFIG: config file name in backup-configs/ for drive ID lookup
# ROOT_BACKUP_DATASET: full dataset path to mount at /mnt/root
export ROOT_BACKUP_POOL=""
export ROOT_BACKUP_CONFIG=""
export ROOT_BACKUP_DATASET=""
